{
  "name": "bitan-pond",
  "version": "1.0.0",
  "description": "塘里：会跟着天气变化的桌面池塘",
  "main": "main.js",
  "author": "local",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/seasons.test.cjs test/fish-species.test.cjs test/fish-motion.test.cjs test/fish-formation.test.cjs test/boss-activity.test.cjs test/boss-dance.test.cjs test/pond-performance.test.cjs test/music-beat.test.cjs test/friend-outfit.test.cjs",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "local.bitan.pond",
    "productName": "塘里",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "media-monitor.js",
      "media-watch.ps1",
      "music-beat.js",
      "music-beat.cs",
      "wallpaper.ps1",
      "desk-input.cs",
      "web/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "executableName": "塘里",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "塘里.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
